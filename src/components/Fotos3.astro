<!-- ═══════════════════════════════════════════════════════════ --><!-- 📸 SECCIÓN: GALERÍA DE FOTOS                                --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-2 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto pt-4 pe-8 pb-4 ps-4 sm:px-6 lg:px-8">
        <!-- CONTENEDOR DE FOTOS -->
        <div class="relative w-full max-w-md mx-auto">
            <!-- FOTO GRANDE - IZQUIERDA/ARRIBA -->
            <div
                id="g3-foto1"
                class="relative w-full aspect-[4/5] rounded-lg shadow-[0_10px_30px_-14px_rgba(95,27,28,0.25)] overflow-hidden cursor-pointer transform transition-all duration-300 hover:scale-105 hover:shadow-[0_18px_45px_-22px_rgba(95,27,28,0.28)]"
                data-aos="fade-right"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <img
                    src="/imagenes/foto5.webp"
                    alt="Foto 1"
                    class="w-full h-full object-cover"
                />
            </div>
            <!-- FOTO PEQUEÑA - DERECHA/ABAJO -->
            <div
                id="g3-foto2"
                class="absolute bottom-0 right-2 w-[45%] aspect-[4/5] rounded-lg shadow-[0_10px_30px_-14px_rgba(95,27,28,0.25)] overflow-hidden cursor-pointer translate-x-6 translate-y-6 transform transition-all duration-300 hover:scale-105 hover:shadow-[0_18px_45px_-22px_rgba(95,27,28,0.28)]"
                data-aos="fade-left"
                data-aos-duration="800"
                data-aos-delay="300"
            >
                <img
                    src="/imagenes/foto6.webp"
                    alt="Foto 2"
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🖼️ MODAL CON FONDO BLANCO ELEGANTE                         -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div
    id="g3-modalFoto"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    style="opacity: 0; transition: opacity 0.3s ease; backdrop-filter: blur(10px);"
>
    <!-- FONDO BLANCO CON TOQUE PLOMO -->
    <div
        class="absolute inset-0 bg-gradient-to-br from-[#fbf6f2] via-[#f3e7df] to-[#fffcfa] opacity-98"
    >
    </div>

    <!-- CONTENIDO DEL MODAL -->
    <div class="relative max-w-5xl w-full z-10">
        <!-- BOTÓN CERRAR -->
        <button
            id="g3-btnCerrar"
            class="absolute -top-12 right-0 text-[#a37261] hover:text-[#5f1b1c] transition-all duration-200 text-4xl font-bold hover:scale-110 hover:rotate-90 drop-shadow-lg"
            aria-label="Cerrar modal"
        >
            ✕
        </button>
        <!-- IMAGEN PRINCIPAL NÍTIDA -->
        <img
            id="g3-modalImage"
            src=""
            alt="Foto ampliada"
            class="w-full h-auto max-h-[90vh] object-contain rounded-lg shadow-[0_18px_45px_-22px_rgba(95,27,28,0.28)]"
        />
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📦 LIBRERÍA AOS PARA ANIMACIONES                            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"
/>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"
></script>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📜 JAVASCRIPT PARA EL MODAL Y ANIMACIONES                   -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script is:inline>
    // Inicializar AOS
    AOS.init({
        duration: 800,
        easing: "ease-in-out",
        once: true,
        mirror: false,
        offset: 100,
    });

    // Esperar a que el DOM esté listo
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("g3-modalFoto");
        const modalImage = document.getElementById("g3-modalImage");
        const foto1 = document.getElementById("g3-foto1");
        const foto2 = document.getElementById("g3-foto2");
        const btnCerrar = document.getElementById("g3-btnCerrar");

        // Función para abrir modal
        function abrirModal(imageSrc) {
            modalImage.src = imageSrc;
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";

            // Animación de entrada
            setTimeout(() => {
                modal.style.opacity = "1";
            }, 10);
        }

        // Función para cerrar modal
        function cerrarModal() {
            modal.style.opacity = "0";
            setTimeout(() => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                document.body.style.overflow = "auto";
            }, 300);
        }

        // Click en foto 1
        if (foto1) {
            foto1.addEventListener("click", function () {
                abrirModal("/imagenes/foto5.webp");
            });
        }

        // Click en foto 2
        if (foto2) {
            foto2.addEventListener("click", function () {
                abrirModal("/imagenes/foto6.webp");
            });
        }

        // Click en botón cerrar
        if (btnCerrar) {
            btnCerrar.addEventListener("click", function (e) {
                e.stopPropagation();
                cerrarModal();
            });
        }

        // Click en el fondo para cerrar
        if (modal) {
            modal.addEventListener("click", function (e) {
                if (e.target === modal) {
                    cerrarModal();
                }
            });
        }

        // Prevenir cierre al clickear la imagen
        if (modalImage) {
            modalImage.addEventListener("click", function (e) {
                e.stopPropagation();
            });
        }

        // Cerrar con tecla ESC
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                cerrarModal();
            }
        });
    });
</script>
