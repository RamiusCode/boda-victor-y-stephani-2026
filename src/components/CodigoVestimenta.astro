<!-- ═══════════════════════════════════════════════════════════ --><!-- 👔 SECCIÓN: DRESS CODE                                      --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-10 pb-10 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- 📇 CARD DE DRESS CODE -->
        <div class="flex justify-center">
            <div class="relative w-[300px]" id="card-dresscode">
                <!-- BOTÓN DECORATIVO SUPERIOR -->
                <div
                    class="absolute z-20"
                    style="top: -30px; left: 50%; transform: translateX(-50%);"
                >
                    <div class="w-16 h-16" id="boton-decorativo-dresscode">
                        <img
                            src="/imagenes/boton.png"
                            alt="Decoración"
                            class="w-full h-full object-contain"
                        />
                    </div>
                </div>

                <!-- CARD PRINCIPAL -->
                <div
                    class="relative rounded-[40px] overflow-hidden card-roja"
                    id="card-principal-dresscode"
                >
                    <!-- IMAGEN DE FONDO -->
                    <img
                        src="/imagenes/fondorojo.png"
                        alt="Fondo dress code"
                        class="absolute inset-0 w-full h-full object-cover"
                    />

                    <!-- Contenido de la card -->
                    <div class="relative px-2 pt-16 pb-10 z-10">
                        <!-- TÍTULO PRINCIPAL -->
                        <div class="text-center mb-6" id="titulo-dresscode">
                            <h2
                                class="font-great-vibes text-[2.5rem] text-[#dfbb84] leading-none mb-2"
                            >
                                Dress Code
                            </h2>
                            <p
                                class="font-crimson text-lg uppercase tracking-widest text-white font-semibold"
                            >
                                FORMAL – ELEGANTE
                            </p>
                        </div>

                        <!-- SECCIÓN: ELLOS Y ELLAS -->
                        <div
                            class="flex justify-center gap-4 mb-2"
                            id="seccion-vestimenta"
                        >
                            <!-- ELLOS -->
                            <div class="text-center flex-1" id="seccion-ellos">
                                <div class="mb-3">
                                    <img
                                        src="/imagenes/trajehombre.png"
                                        alt="Traje Formal"
                                        class="w-[43px] h-auto mx-auto icono-dresscode"
                                    />
                                </div>
                                <h3
                                    class="font-crimson text-lg uppercase tracking-wider text-[#dfbb84] font-bold mb-2"
                                >
                                    CABALLEROS
                                </h3>
                                <p
                                    class="font-crimson text-lg leading-tight text-white"
                                >
                                    Traje Formal
                                </p>
                            </div>

                            <!-- ELLAS -->
                            <div class="text-center flex-1" id="seccion-ellas">
                                <div class="mb-3">
                                    <img
                                        src="/imagenes/trajemujer.png"
                                        alt="Vestido Largo"
                                        class="w-20 h-auto mx-auto icono-dresscode"
                                    />
                                </div>
                                <h3
                                    class="font-crimson text-lg uppercase tracking-wider text-[#dfbb84] font-bold mb-2"
                                >
                                    DAMAS
                                </h3>
                                <p
                                    class="font-crimson text-lg leading-tight text-white"
                                >
                                    Vestido de Gala
                                </p>
                            </div>
                        </div>

                        <!-- SECCIÓN: COLORES RESERVADOS -->
                        <div class="text-center mt-6 mb-4" id="seccion-colores">
                            <h3
                                class="font-crimson text-base uppercase tracking-wider text-[#dfbb84] font-bold mb-3"
                            >
                                COLORES RESERVADOS
                            </h3>
                            <div class="flex justify-center gap-4 mb-2">
                                <div class="flex flex-col items-center gap-1">
                                    <div
                                        class="w-10 h-10 rounded-full border-2 border-white"
                                        style="background-color: #6b1f2a;"
                                    >
                                    </div>
                                    <span
                                        class="font-crimson text-xs uppercase tracking-wide text-white"
                                        >Guindo</span
                                    >
                                </div>
                                <div class="flex flex-col items-center gap-1">
                                    <div
                                        class="w-10 h-10 rounded-full border-2 border-white"
                                        style="background-color: #ffffff;"
                                    >
                                    </div>
                                    <span
                                        class="font-crimson text-xs uppercase tracking-wide text-white"
                                        >Blanco</span
                                    >
                                </div>
                                <div class="flex flex-col items-center gap-1">
                                    <div
                                        class="w-10 h-10 rounded-full border-2 border-white"
                                        style="background-color: #8a9a86;"
                                    >
                                    </div>
                                    <span
                                        class="font-crimson text-xs uppercase tracking-wide text-white leading-tight text-center"
                                        >Verde<br />eucalipto</span
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- NOTA FINAL — comentada, puede volver a usarse.
                             Si se reactiva, descomentar también su animación
                             GSAP más abajo (busca "#nota-final").
                        <div class="text-center" id="nota-final">
                            <p
                                class="font-crimson text-lg leading-relaxed text-white italic"
                            >
                                NO ASISTIR DE GUINDO,<br />
                                BLANCO O TONOS SIMILARES,<br />
                                NI VERDE EUCALIPTO
                            </p>
                        </div>
                        -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS PARA LOS ICONOS                                  -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    .icono-dresscode {
        filter: brightness(0) saturate(100%) invert(67%) sepia(18%)
            saturate(650%) hue-rotate(357deg) brightness(114%) contrast(94%);
    }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP - SOLO AL BAJAR (SIN PERDER CONTENIDO) -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            // Animación del botón decorativo
            gsap.fromTo(
                "#boton-decorativo-dresscode",
                {
                    opacity: 0,
                    scale: 0,
                    rotation: -180,
                },
                {
                    opacity: 1,
                    scale: 1,
                    rotation: 0,
                    duration: 1,
                    ease: "back.out(1.7)",
                    scrollTrigger: {
                        trigger: "#card-dresscode",
                        start: "top 80%",
                        toggleActions: "play none none reset", // ✅ Solo play al bajar
                    },
                },
            );

            // Animación de la card
            gsap.fromTo(
                "#card-principal-dresscode",
                {
                    opacity: 0,
                    y: 50,
                    scale: 0.95,
                },
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#card-dresscode",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación del título
            gsap.fromTo(
                "#titulo-dresscode",
                {
                    opacity: 0,
                    y: -20,
                },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-dresscode",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación ellos (desde la izquierda)
            gsap.fromTo(
                "#seccion-ellos",
                {
                    opacity: 0,
                    x: -30,
                },
                {
                    opacity: 1,
                    x: 0,
                    duration: 0.8,
                    delay: 0.2,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-dresscode",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación ellas (desde la derecha)
            gsap.fromTo(
                "#seccion-ellas",
                {
                    opacity: 0,
                    x: 30,
                },
                {
                    opacity: 1,
                    x: 0,
                    duration: 0.8,
                    delay: 0.2,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-dresscode",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación de colores
            gsap.fromTo(
                "#seccion-colores",
                {
                    opacity: 0,
                    y: 20,
                },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.6,
                    delay: 0.4,
                    ease: "power2.out",
                    scrollTrigger: {
                        trigger: "#card-dresscode",
                        start: "top 80%",
                        toggleActions: "play none none reset",
                    },
                },
            );

            // Animación nota final — comentada junto con su bloque HTML.
            // Descomentar si se vuelve a mostrar la nota.
            // gsap.fromTo(
            //     "#nota-final",
            //     {
            //         opacity: 0,
            //         y: 20,
            //     },
            //     {
            //         opacity: 1,
            //         y: 0,
            //         duration: 0.6,
            //         delay: 0.6,
            //         ease: "power2.out",
            //         scrollTrigger: {
            //             trigger: "#card-dresscode",
            //             start: "top 80%",
            //             toggleActions: "play none none reset",
            //         },
            //     },
            // );
        });
    }
</script>
